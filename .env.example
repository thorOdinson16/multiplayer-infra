# Copy to .env to override the defaults used by docker-compose.yml.
# Every value below is also the built-in default, so the stack runs without a .env.
# These are local-development credentials. Do not reuse them anywhere real.

POSTGRES_USER=game
POSTGRES_PASSWORD=game
POSTGRES_DB=game

RABBITMQ_USER=guest
RABBITMQ_PASS=guest

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
